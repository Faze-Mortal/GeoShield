# GeoShield Backend — Environment Configuration Template
# Copy this file to .env in this directory.

# PostgreSQL connection string (use read-only user in production)
DATABASE_URL=postgresql+psycopg2://[[PLACEHOLDER: DB_USER]]:[[PLACEHOLDER: DB_PASSWORD]]@localhost:5432/geoshield

# CORS allowed origins (comma-separated list of origins)
# In production on Render, include your deployed Vercel frontend origin:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://geoshield-hazel.vercel.app

# API documentation toggle (set to false in production to disable /docs and /openapi.json)
ENABLE_DOCS=true
