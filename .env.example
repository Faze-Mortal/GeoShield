# GeoShield Monorepo — Environment Variables Guide
# See subproject templates:
# - Frontend: geoshield-frontend/.env.local.example
# - Backend:  GeoShield_Backend/GeoShield_Backend/backend/.env.example

# Frontend (geoshield-frontend/.env.local or Vercel Environment Variables):
# NEXT_PUBLIC_API_BASE_URL=https://geoshield-api-9nl7.onrender.com
# NEXT_PUBLIC_SITE_URL=https://geoshield-hazel.vercel.app
# NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# NEXT_PUBLIC_USE_MOCKS=false

# Backend (GeoShield_Backend/GeoShield_Backend/backend/.env or Render Environment Variables):
# DATABASE_URL=postgresql+psycopg2://[[PLACEHOLDER: DB_USER]]:[[PLACEHOLDER: DB_PASSWORD]]@[[PLACEHOLDER: DB_HOST]]:5432/postgres
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://geoshield-hazel.vercel.app
# ENABLE_DOCS=false
