# GeoShield Monorepo — Environment Variables Guide
# See subproject templates:
# - Frontend: geoshield-frontend/.env.local.example
# - Backend:  GeoShield_Backend/GeoShield_Backend/backend/.env.example

# Frontend (geoshield-frontend/.env.local):
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_SITE_URL=https://[[PLACEHOLDER: your-domain.com]]
# NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# NEXT_PUBLIC_USE_MOCKS=false

# Backend (GeoShield_Backend/GeoShield_Backend/backend/.env):
# DATABASE_URL=postgresql+psycopg2://[[PLACEHOLDER: DB_USER]]:[[PLACEHOLDER: DB_PASSWORD]]@localhost:5432/geoshield
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ENABLE_DOCS=true
