# GeoShield Frontend — Environment Variables Template
# Copy this file to .env.local for local development.

# Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Canonical Site URL for metadata & SEO (use placeholder until production domain is assigned)
NEXT_PUBLIC_SITE_URL=https://[[PLACEHOLDER: your-domain.com]]

# Public Basemap Style URL (Carto Dark Matter GL Style)
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Offline mock adapter fallback (keep false in production)
NEXT_PUBLIC_USE_MOCKS=false
