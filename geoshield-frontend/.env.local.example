# GeoShield Frontend — Environment Variables Template
# Copy this file to .env.local for local development.

# Backend API Base URL
# Development: http://127.0.0.1:8000
# Production on Vercel: https://geoshield-api-9nl7.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Canonical Site URL for metadata & SEO
# Deployed Vercel URL: https://geoshield-hazel.vercel.app (or custom domain)
NEXT_PUBLIC_SITE_URL=https://geoshield-hazel.vercel.app

# Public Basemap Style URL (Carto Dark Matter GL Style)
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Offline mock adapter fallback (keep false in production)
NEXT_PUBLIC_USE_MOCKS=false
